{
  "headers": [
    { "source": "/chars/(.*)\\.glb", "headers": [
      { "key": "Content-Type", "value": "model/gltf-binary" },
      { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/chars/(.*)\\.js", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/anims.js", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
